{
  "entities": {
    "Post": {
      "title": "Blog Post",
      "description": "A news or blog article for the CMS.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "image": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["title", "content", "authorId", "createdAt"]
    },
    "Product": {
      "title": "Shop Product",
      "description": "A product listed in the shop.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "image", "createdAt"]
    },
    "User": {
      "title": "User Profile",
      "description": "Public and private user data.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isAdmin": { "type": "boolean" }
      }
    },
    "Subscriber": {
      "title": "Newsletter Subscriber",
      "description": "User subscribed to the newsletter.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "subscribedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "unsubscribed"] }
      },
      "required": ["email", "subscribedAt", "status"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Collection of blog posts and news."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of products for the shop."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/subscribers/{email}": {
      "schema": "Subscriber",
      "description": "Newsletter subscription list."
    }
  }
}
