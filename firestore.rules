rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Admin check: checks if user uid exists in /admins/ collection
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // --- Validation Helpers ---
    
    function isValidPost(data) {
      return data.keys().hasAll(['title', 'content', 'authorId', 'createdAt'])
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 50000
        && data.authorId == request.auth.uid
        && data.createdAt == request.time
        && (data.get('image', '') is string)
        && (data.get('category', '') is string);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'image', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.price is number && data.price >= 0
        && data.image is string
        && data.createdAt == request.time;
    }

    function isValidUser(data) {
      return data.get('displayName', '') is string && data.get('displayName', '').size() <= 100
        && data.get('email', '') is string && data.get('email', '').size() <= 100
        && (data.get('isAdmin', false) == false || isAdmin()); 
    }

    function isValidSubscriber(data) {
      return data.email is string && data.email.size() <= 100
        && data.subscribedAt == request.time
        && data.status in ['active', 'unsubscribed'];
    }

    // --- Collections ---

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }

    match /posts/{postId} {
      allow read: if true; 
      allow create: if isVerified() && isValidId(postId) && isValidPost(incoming());
      allow update: if (isAdmin() || (isVerified() && isOwner(existing().authorId)))
        && isValidPost(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() || (isVerified() && isOwner(existing().authorId));
    }

    match /products/{productId} {
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isVerified() && isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email']));
      allow delete: if isAdmin();
    }

    match /subscribers/{email} {
      allow read: if isAdmin();
      allow create: if true; 
      allow update: if isAdmin() || (isSignedIn() && request.auth.token.email == email);
    }
  }
}
