<section class="py-12">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold mb-8"><?= htmlspecialchars($pageTitle) ?></h1>

        <?php if (!empty($articles)): ?>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
                <?php foreach ($articles as $article): ?>
                    <article class="bg-white rounded shadow hover:shadow-lg transition overflow-hidden">
                        <?php if (!empty($article['imageUrl'])): ?>
                            <img src="<?= htmlspecialchars($article['imageUrl']) ?>" alt="Blog" class="w-full h-40 object-cover">
                        <?php else: ?>
                            <div class="w-full h-40 bg-gradient-to-r from-secondary to-accent"></div>
                        <?php endif; ?>
                        <div class="p-6">
                            <time class="text-gray-500 text-sm">
                                <?= $article['createdAt']->format('d.m.Y H:i') ?? date('d.m.Y') ?>
                            </time>
                            <h3 class="text-xl font-bold mt-2 mb-2 line-clamp-2"><?= htmlspecialchars($article['title']) ?></h3>
                            <p class="text-gray-600 line-clamp-2 mb-4"><?= htmlspecialchars(substr(strip_tags($article['content']), 0, 100)) ?>...</p>
                            <?php if (!empty($article['tags'])): ?>
                                <div class="flex gap-2 flex-wrap mb-4">
                                    <?php foreach ($article['tags'] as $tag): ?>
                                        <span class="text-xs bg-gray-100 px-2 py-1 rounded"><?= htmlspecialchars($tag) ?></span>
                                    <?php endforeach; ?>
                                </div>
                            <?php endif; ?>
                            <a href="/blog/<?= htmlspecialchars($article['id']) ?>" class="text-primary hover:text-blue-600 transition font-semibold">Weiterlesen →</a>
                        </div>
                    </article>
                <?php endforeach; ?>
            </div>

            <!-- Pagination -->
            <div class="flex justify-center gap-2 mt-12">
                <?php if ($page > 1): ?>
                    <a href="/blog?page=<?= $page - 1 ?>" class="px-4 py-2 border rounded hover:bg-gray-100">← Zurück</a>
                <?php endif; ?>
                <span class="px-4 py-2">Seite <?= $page ?></span>
                <?php if (count($articles) >= $limit): ?>
                    <a href="/blog?page=<?= $page + 1 ?>" class="px-4 py-2 border rounded hover:bg-gray-100">Weiter →</a>
                <?php endif; ?>
            </div>
        <?php else: ?>
            <div class="bg-gray-100 p-12 rounded text-center">
                <p class="text-gray-600 text-lg">Noch keine Blog-Artikel verfügbar</p>
            </div>
        <?php endif; ?>
    </div>
</section>
