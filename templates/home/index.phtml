<section class="section-stats">
    <div class="container mx-auto px-4 max-w-2xl text-center">
        <div class="reveal">
            <p class="font-mono text-xs uppercase tracking-widest text-primary mb-4">Bleib informiert</p>
            <h2 class="font-serif text-5xl md:text-7xl font-black mb-4">Newsletter</h2>
            <span class="accent-line"></span>
        </div>

        <p class="font-mono text-muted mb-12 reveal reveal-delay-1">
            Erhalte die neuesten Updates direkt in dein Postfach
        </p>

        <form id="newsletter-form" class="flex gap-0 reveal reveal-delay-2">
            <input type="email" id="newsletter-email" required placeholder="deine@email.de" class="flex-1 bg-transparent border-b-2 border-paper text-paper placeholder-muted px-4 py-3 focus:outline-none focus:border-primary transition font-mono">
            <button type="submit" class="border-2 border-primary bg-primary text-void px-8 py-3 font-mono text-xs uppercase tracking-widest font-black hover:bg-transparent hover:text-primary transition">
                Abonnieren
            </button>
        </form>
    </div>
</section>

<script>
document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = document.getElementById('newsletter-email').value.trim();
    const submitBtn = e.target.querySelector('button[type="submit"]');
    const originalText = submitBtn.textContent;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Wird abgesendet...';

    try {
        const res = await fetch('/api/newsletter/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email })
        });

        const data = await res.json();

        if (data.success) {
            App.showNotification('Danke für dein Abonnement!', 'success');
            e.target.reset();
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
        } else {
            App.showNotification(data.error || 'Fehler beim Abonnieren', 'error');
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
        }
    } catch (error) {
        console.error('Newsletter signup error:', error);
        App.showNotification('Verbindungsfehler – bitte versuche es später erneut', 'error');
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
    }
});
</script>
