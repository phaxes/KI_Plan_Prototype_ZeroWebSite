<section class="py-12">
    <div class="container mx-auto px-4 max-w-md">
        <h1 class="text-4xl font-bold mb-8"><?= htmlspecialchars($pageTitle) ?></h1>

        <div class="bg-white rounded shadow p-8">
            <form id="change-password-form">
                <div class="mb-6">
                    <label class="block text-gray-700 font-semibold mb-2">Aktuelles Passwort</label>
                    <input type="password" id="currentPassword" required class="w-full px-4 py-2 border rounded" placeholder="••••••••">
                </div>

                <div class="mb-6">
                    <label class="block text-gray-700 font-semibold mb-2">Neues Passwort</label>
                    <input type="password" id="newPassword" required class="w-full px-4 py-2 border rounded" placeholder="••••••••">
                    <p class="text-sm text-gray-600 mt-1">Mindestens 6 Zeichen</p>
                </div>

                <div class="mb-6">
                    <label class="block text-gray-700 font-semibold mb-2">Passwort wiederholen</label>
                    <input type="password" id="confirmPassword" required class="w-full px-4 py-2 border rounded" placeholder="••••••••">
                </div>

                <button type="submit" id="submit-button" class="w-full bg-primary text-white px-6 py-3 rounded hover:bg-blue-600 transition font-semibold">
                    <span id="button-text">Passwort ändern</span>
                    <span id="loading-spinner" class="hidden ml-2">
                        <svg class="animate-spin h-5 w-5 inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </span>
                </button>
            </form>

            <div class="border-t mt-6 pt-6">
                <a href="/profile" class="text-primary hover:text-blue-600 transition font-semibold">← Zurück zum Profil</a>
            </div>
        </div>
    </div>
</section>

<script>
document.getElementById('change-password-form').addEventListener('submit', async function(e) {
    e.preventDefault();

    const currentPassword = document.getElementById('currentPassword').value;
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;

    // Validation
    if (!currentPassword || !newPassword || !confirmPassword) {
        App.showNotification('Bitte alle Felder ausfüllen', 'error');
        return;
    }

    if (newPassword !== confirmPassword) {
        App.showNotification('Neue Passwörter stimmen nicht überein', 'error');
        return;
    }

    if (newPassword.length < 6) {
        App.showNotification('Passwort muss mindestens 6 Zeichen lang sein', 'error');
        return;
    }

    if (currentPassword === newPassword) {
        App.showNotification('Neues Passwort muss sich vom alten unterscheiden', 'error');
        return;
    }

    // Show loading
    const button = document.getElementById('submit-button');
    const buttonText = document.getElementById('button-text');
    const spinner = document.getElementById('loading-spinner');

    button.disabled = true;
    buttonText.textContent = 'Wird geändert...';
    spinner.classList.remove('hidden');

    try {
        // First, reauthenticate with current password
        const user = auth.currentUser;
        if (!user) {
            throw new Error('No user logged in');
        }

        // Reauthenticate
        const credential = firebase.auth.EmailAuthProvider.credential(
            user.email,
            currentPassword
        );

        await user.reauthenticateWithCredential(credential);
        console.log('Reauthentication successful');

        // Now update password
        await user.updatePassword(newPassword);
        console.log('Password updated successfully');

        App.showNotification('Passwort erfolgreich geändert!', 'success');

        // Clear form
        setTimeout(() => {
            document.getElementById('change-password-form').reset();
            button.disabled = false;
            buttonText.textContent = 'Passwort ändern';
            spinner.classList.add('hidden');

            // Redirect to profile
            setTimeout(() => {
                window.location.href = '/profile';
            }, 1000);
        }, 500);

    } catch (error) {
        console.error('Password change error:', error);
        let message = 'Fehler beim Ändern des Passworts';

        if (error.code === 'auth/wrong-password') {
            message = 'Aktuelles Passwort ist falsch';
        } else if (error.code === 'auth/weak-password') {
            message = 'Neues Passwort ist zu schwach';
        } else if (error.message) {
            message = error.message;
        }

        App.showNotification(message, 'error');

        button.disabled = false;
        buttonText.textContent = 'Passwort ändern';
        spinner.classList.add('hidden');
    }
});
</script>
